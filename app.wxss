page {
    min-height: 100%;
    background: #0f1420;
    color: #f4ead6;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
    border-radius: 16rpx;
}

/* 通用按钮 */
.btn-primary {
    background: linear-gradient(180deg, #f0c46a, #d99a34);
    color: #1a1408;
    font-weight: 700;
}

.btn-ghost {
    background: transparent;
    color: #e8b04b;
    border: 2rpx solid rgba(232, 176, 75, 0.45);
    font-weight: 600;
}

.btn-disabled {
    opacity: 0.35;
}
