.pm-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: rgba(6, 9, 16, 0.84);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48rpx;
    box-sizing: border-box;
}

.pm-panel {
    width: 100%;
    max-width: 620rpx;
    background: #1a2233;
    border: 2rpx solid rgba(232, 176, 75, 0.3);
    border-radius: 24rpx;
    padding: 44rpx 40rpx 32rpx;
    box-sizing: border-box;
    box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.55);
}

.pm-title {
    font-size: 36rpx;
    font-weight: 700;
    color: #f4ead6;
    text-align: center;
    margin-bottom: 26rpx;
}

.pm-desc {
    font-size: 27rpx;
    line-height: 1.7;
    color: rgba(244, 234, 214, 0.72);
}

.pm-link {
    color: #e8b04b;
}

.pm-list {
    margin-top: 24rpx;
    padding: 22rpx 24rpx;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 14rpx;
}

.pm-item {
    font-size: 25rpx;
    line-height: 1.75;
    color: rgba(244, 234, 214, 0.78);
}

.pm-actions {
    display: flex;
    gap: 20rpx;
    margin-top: 36rpx;
}

.pm-btn {
    flex: 1;
    margin: 0;
    padding: 0 12rpx;
    height: 84rpx;
    line-height: 84rpx;
    font-size: 29rpx;
    font-weight: 700;
    border-radius: 16rpx;
}

.pm-btn::after {
    border: none;
}

.pm-btn-ghost {
    background: transparent;
    color: rgba(244, 234, 214, 0.7);
    border: 2rpx solid rgba(244, 234, 214, 0.22);
}

.pm-btn-primary {
    background: linear-gradient(180deg, #f0c46a, #d99a34);
    color: #1a1408;
}

.pm-foot {
    margin-top: 22rpx;
    font-size: 22rpx;
    line-height: 1.6;
    text-align: center;
    color: rgba(244, 234, 214, 0.38);
}
