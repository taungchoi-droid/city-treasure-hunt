<view class="page">
    <view class="map-wrap">
        <map
            id="treasureMap"
            class="the-map"
            latitude="{{latitude}}"
            longitude="{{longitude}}"
            scale="{{scale}}"
            markers="{{markers}}"
            circles="{{circles}}"
            polyline="{{polyline}}"
            show-location="{{!manualMode}}"
            bindmarkertap="onMarkerTap">

            <cover-view class="map-top">
                <cover-view class="chip chip-nav" wx:if="{{navMode && navLoading}}">正在读取宝物位置…</cover-view>
                <cover-view class="chip chip-pos" wx:elif="{{navMode && navError}}">{{navError}}</cover-view>
                <cover-view class="chip chip-nav" wx:elif="{{navMode}}">导航中 · {{navDistText}}</cover-view>
                <cover-view class="chip chip-pos" wx:elif="{{viewState === 'loading'}}">正在获取你的位置…</cover-view>
                <cover-view class="chip" wx:elif="{{manualMode}}">{{posLabel}}</cover-view>
                <cover-view class="chip" wx:else>{{radiusLabels[radiusIndex]}}内发现 {{nearbyCount}} 个宝物</cover-view>
            </cover-view>

            <cover-view class="map-actions">
                <cover-view wx:if="{{navMode}}" class="action-btn action-alt" bindtap="refocusNav">对准路线</cover-view>
                <cover-view wx:if="{{navMode}}" class="action-btn action-alt" bindtap="exitNav">结束导航</cover-view>
                <cover-view wx:if="{{!navMode}}" class="action-btn" bindtap="locate">刷新位置</cover-view>
                <cover-view wx:if="{{manualMode}}" class="action-btn action-alt" bindtap="useMapCenter">以地图中心定位</cover-view>
                <cover-view wx:if="{{manualMode}}" class="action-btn action-alt" bindtap="openSetting">打开设置</cover-view>
                <cover-view wx:if="{{!navMode}}" class="action-btn action-gold" bindtap="goBury">藏一个</cover-view>
            </cover-view>
        </map>
    </view>

    <!-- 导航专注模式：只显示目标与路线，其它宝物标志/附近列表全部隐藏 -->
    <view class="nav-panel" wx:if="{{navMode}}">
        <view class="nav-head">
            <view class="nav-title">前往「{{navTarget ? navTarget.name : '宝物'}}」</view>
            <view class="nav-dist">{{navDistText}}</view>
        </view>
        <view class="nav-sub">{{navWalkText}}</view>
        <view class="nav-tip nav-tip-loading" wx:if="{{navRouteState === 'loading'}}">正在规划沿道路路线…</view>
        <view class="nav-tip nav-tip-ready" wx:elif="{{navRouteState === 'ready'}}">大数字是直线距离，走进 30 米即可带走；金色路线是沿道路的实际路线。</view>
        <view class="nav-tip nav-tip-fallback" wx:elif="{{navRouteState === 'fallback'}}">{{navRouteHint}}</view>
        <view class="nav-tip" wx:else>进入导航后会自动规划沿道路步行路线。</view>
        <view class="nav-links" wx:if="{{navRouteState === 'ready' || navRouteState === 'fallback'}}">
            <view class="nav-link" bindtap="replanRoute">重新规划路线</view>
        </view>
        <view class="nav-btns">
            <button class="btn-primary nav-btn" disabled="{{!navTarget || navLoading}}" bindtap="openWxNav">微信地图导航</button>
            <button class="btn-ghost nav-btn" bindtap="exitNav">结束导航</button>
        </view>
        <view class="nav-retry" wx:if="{{navError}}" bindtap="retryNavTarget">重新读取宝物</view>
    </view>

    <view class="nearby-panel" wx:else>
        <view class="panel-head">
            <view class="panel-title">附近宝物（{{nearbyCount}}）</view>
            <picker
                class="radius-picker"
                mode="selector"
                range="{{radiusLabels}}"
                value="{{radiusIndex}}"
                bindchange="onRadiusChange">
                <view class="radius-btn">范围 {{radiusLabels[radiusIndex]}} ▾</view>
            </picker>
        </view>
        <view wx:if="{{nearbyCount === 0}}" class="panel-empty">
            范围内暂无宝物。走动一下、扩大查看范围，或自己埋一个。
        </view>
        <scroll-view wx:else scroll-y class="nearby-scroll">
            <view
                wx:for="{{nearbyList}}"
                wx:key="id"
                class="treasure-row"
                data-id="{{item.id}}"
                bindtap="onRowTap">
                <view class="t-name">{{item.name}}</view>
                <view class="t-dist">{{item.distText}}</view>
            </view>
        </scroll-view>
    </view>
</view>

<privacy-modal />
