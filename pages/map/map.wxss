.page {
    display: flex;
    flex-direction: column;
    height: 100vh;
}

/* 地图区：占剩余空间，浮层只留状态条 + 操作按钮 */
.map-wrap {
    flex: 1;
    position: relative;
    overflow: hidden;
}

.the-map {
    width: 100%;
    height: 100%;
}

.map-top {
    position: absolute;
    top: 24rpx;
    left: 24rpx;
    right: 24rpx;
}

.chip {
    display: inline-block;
    padding: 10rpx 22rpx;
    border-radius: 999rpx;
    background: rgba(16, 19, 26, 0.88);
    color: #e8b04b;
    font-size: 24rpx;
    line-height: 1.4;
}

.chip-pos {
    color: #9fb3d9;
}

.map-actions {
    position: absolute;
    right: 24rpx;
    top: 120rpx;
    display: flex;
    flex-direction: column;
    gap: 14rpx;
}

.action-btn {
    padding: 14rpx 24rpx;
    border-radius: 14rpx;
    background: rgba(16, 19, 26, 0.88);
    color: #f4ead6;
    font-size: 24rpx;
    text-align: center;
}

.action-alt {
    color: #9fb3d9;
}

.action-gold {
    background: linear-gradient(180deg, #f0c46a, #d99a34);
    color: #1a1408;
    font-weight: 700;
}

/* 附近宝物面板：地图下方常规区域（非 cover-view），可放 picker 滚轮 */
.nearby-panel {
    flex-shrink: 0;
    padding: 22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));
    background: rgba(16, 19, 26, 0.96);
}

.panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.panel-title {
    color: rgba(232, 176, 75, 0.65);
    font-size: 22rpx;
    letter-spacing: 4rpx;
}

.radius-btn {
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    background: rgba(232, 176, 75, 0.14);
    border: 1rpx solid rgba(232, 176, 75, 0.4);
    color: #e8b04b;
    font-size: 24rpx;
    line-height: 1.4;
}

.panel-empty {
    color: rgba(244, 234, 214, 0.55);
    font-size: 26rpx;
    line-height: 1.6;
    padding: 8rpx 0 12rpx;
}

.nearby-scroll {
    max-height: 30vh;
}

.treasure-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18rpx 4rpx;
    border-top: 1rpx solid rgba(232, 176, 75, 0.15);
}

.t-name {
    color: #f4ead6;
    font-size: 28rpx;
}

.t-dist {
    color: #e8b04b;
    font-size: 24rpx;
}

/* ---------- 导航专注模式 ---------- */
.chip-nav {
    color: #4ecb8d;
    font-weight: 600;
}

.nav-panel {
    flex-shrink: 0;
    padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
    background: rgba(16, 19, 26, 0.96);
    border-top: 2rpx solid rgba(232, 176, 75, 0.28);
}

.nav-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16rpx;
}

.nav-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 30rpx;
    font-weight: 700;
    color: #f4ead6;
}

.nav-dist {
    flex-shrink: 0;
    font-size: 34rpx;
    font-weight: 800;
    color: #e8b04b;
    font-variant-numeric: tabular-nums;
}

.nav-sub {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(244, 234, 214, 0.65);
}

.nav-tip {
    margin-top: 14rpx;
    font-size: 22rpx;
    line-height: 1.6;
    color: rgba(244, 234, 214, 0.4);
}

/* 沿道路路线的四种状态提示 */
.nav-tip-loading {
    color: #9fb3d9;
}

.nav-tip-ready {
    color: rgba(78, 203, 141, 0.78);
}

.nav-tip-fallback {
    color: rgba(232, 176, 75, 0.88);
}

.nav-links {
    margin-top: 14rpx;
}

.nav-link {
    display: inline-block;
    padding: 6rpx 0;
    font-size: 24rpx;
    color: #9fb3d9;
}

.nav-btns {
    display: flex;
    gap: 20rpx;
    margin-top: 22rpx;
}

.nav-btn {
    flex: 1;
    min-width: 0;
    margin: 0;
    height: 80rpx;
    line-height: 80rpx;
    font-size: 27rpx;
    padding: 0 10rpx;
}

.nav-btn::after {
    border: none;
}

.nav-retry {
    margin-top: 18rpx;
    text-align: center;
    font-size: 24rpx;
    color: #9fb3d9;
}
