.the-map {
    width: 100vw;
    height: 100vh;
}

.map-top {
    position: absolute;
    top: 24rpx;
    left: 24rpx;
    right: 24rpx;
}

.chip {
    display: inline-block;
    padding: 10rpx 22rpx;
    border-radius: 999rpx;
    background: rgba(16, 19, 26, 0.88);
    color: #e8b04b;
    font-size: 24rpx;
    line-height: 1.4;
}

.chip-pos {
    color: #9fb3d9;
}

.map-actions {
    position: absolute;
    right: 24rpx;
    top: 120rpx;
    display: flex;
    flex-direction: column;
    gap: 14rpx;
}

.action-btn {
    padding: 14rpx 24rpx;
    border-radius: 14rpx;
    background: rgba(16, 19, 26, 0.88);
    color: #f4ead6;
    font-size: 24rpx;
    text-align: center;
}

.action-alt {
    color: #9fb3d9;
}

.action-gold {
    background: linear-gradient(180deg, #f0c46a, #d99a34);
    color: #1a1408;
    font-weight: 700;
}

.nearby-panel {
    position: absolute;
    left: 24rpx;
    right: 24rpx;
    bottom: 40rpx;
    max-height: 40vh;
    padding: 24rpx 24rpx 20rpx;
    border-radius: 22rpx;
    background: rgba(16, 19, 26, 0.92);
    overflow-y: auto;
}

.panel-title {
    color: rgba(232, 176, 75, 0.65);
    font-size: 22rpx;
    letter-spacing: 4rpx;
    margin-bottom: 12rpx;
}

.panel-empty {
    color: rgba(244, 234, 214, 0.55);
    font-size: 26rpx;
    line-height: 1.6;
    padding: 8rpx 0 12rpx;
}

.treasure-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18rpx 4rpx;
    border-top: 1rpx solid rgba(232, 176, 75, 0.15);
}

.t-name {
    color: #f4ead6;
    font-size: 28rpx;
}

.t-dist {
    color: #e8b04b;
    font-size: 24rpx;
}
