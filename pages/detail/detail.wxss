.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 28rpx 28rpx 64rpx;
}

/* 整页合并为一张主卡，内部用细分隔线分区，去掉重复边框/圆角/间距 */
.main-card {
    box-sizing: border-box;
    border-radius: 24rpx;
    border: 2rpx solid rgba(232, 176, 75, 0.22);
    background: rgba(26, 30, 41, 0.85);
    overflow: hidden;
}

.main-card > view {
    padding: 28rpx 30rpx;
}

.main-card > view + view {
    border-top: 1rpx solid rgba(232, 176, 75, 0.14);
}

/* 顶部：标题 + 收藏 */
.head-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.head-main {
    flex: 1;
    min-width: 0;
}

.t-name {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: #e8b04b;
}

.t-meta {
    display: block;
    margin-top: 10rpx;
    font-size: 24rpx;
    color: rgba(244, 234, 214, 0.45);
}

.fav-btn {
    flex-shrink: 0;
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 108rpx;
    padding: 12rpx 14rpx;
    border-radius: 14rpx;
    border: 2rpx solid rgba(232, 176, 75, 0.35);
    background: rgba(232, 176, 75, 0.06);
}

.fav-icon {
    font-size: 34rpx;
    line-height: 1;
    color: #e8b04b;
}

.fav-text {
    margin-top: 6rpx;
    font-size: 20rpx;
    color: rgba(232, 176, 75, 0.8);
}

.fav-on {
    border-color: rgba(240, 196, 106, 0.8);
    background: rgba(232, 176, 75, 0.22);
}

.fav-on .fav-icon,
.fav-on .fav-text {
    color: #f0c46a;
}

.riddle-box {
    margin-top: 24rpx;
    padding: 22rpx 24rpx;
    border-radius: 16rpx;
    background: rgba(232, 176, 75, 0.08);
}

.riddle-label {
    display: block;
    font-size: 22rpx;
    letter-spacing: 4rpx;
    color: rgba(232, 176, 75, 0.6);
}

.riddle-text {
    display: block;
    margin-top: 12rpx;
    font-size: 30rpx;
    line-height: 1.7;
    color: #f4ead6;
}

.t-photo {
    width: 100%;
    height: 320rpx;
    border-radius: 16rpx;
    margin-top: 24rpx;
}

.photo-login {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
    padding: 30rpx 0 10rpx;
}

.photo-login-tip {
    font-size: 24rpx;
    color: rgba(244, 234, 214, 0.55);
}

/* 距离状态条：一行紧凑 */
.mc-dist {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.dist-left {
    display: flex;
    align-items: baseline;
    gap: 14rpx;
    min-width: 0;
}

.dist-value {
    font-size: 44rpx;
    font-weight: 800;
    color: #f4ead6;
    font-variant-numeric: tabular-nums;
}

.dist-ok {
    color: #4ecb8d;
}

.dist-tip {
    font-size: 24rpx;
    color: rgba(244, 234, 214, 0.55);
}

.dist-right {
    flex-shrink: 0;
    margin-left: 16rpx;
}

.dist-locate {
    padding: 10rpx 20rpx;
    border-radius: 999rpx;
    border: 1rpx solid rgba(232, 176, 75, 0.4);
    color: #e8b04b;
    font-size: 24rpx;
}

/* 主操作：导航 + 带走 并排 */
.mc-actions {
    display: flex;
    gap: 20rpx;
}

.mc-btn {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0 12rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8rpx;
}

.mc-btn::after,
.mc-share-btn::after,
.mc-hint-submit::after {
    border: none;
}

.mc-btn-icon {
    font-size: 26rpx;
}

.mc-note {
    display: block;
    margin-top: 16rpx;
    font-size: 22rpx;
    color: rgba(244, 234, 214, 0.4);
    text-align: center;
}

/* 追加提示：默认折叠 */
.mc-hint-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.mc-hint-title {
    font-size: 26rpx;
    color: rgba(244, 234, 214, 0.75);
}

.mc-hint-arrow {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 24rpx;
    color: #e8b04b;
}

.hint-input {
    box-sizing: border-box;
    width: 100%;
    height: 140rpx;
    padding: 20rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.06);
    color: #f4ead6;
    font-size: 26rpx;
    margin-top: 22rpx;
}

.mc-hint-submit {
    width: 100%;
    margin-top: 18rpx;
    font-size: 28rpx;
}

/* 分享 */
.mc-share-btn {
    width: 100%;
    margin: 0;
    font-size: 28rpx;
}

/* 提示列表 */
.panel-label {
    display: block;
    font-size: 22rpx;
    letter-spacing: 4rpx;
    color: rgba(232, 176, 75, 0.6);
    margin-bottom: 8rpx;
}

.hint-row {
    display: flex;
    align-items: flex-start;
    padding: 18rpx 0;
    border-top: 1rpx solid rgba(232, 176, 75, 0.12);
}

.hint-avatar {
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    flex-shrink: 0;
}

.hint-avatar-text {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #f0c46a, #d99a34);
    color: #1a1408;
    font-size: 26rpx;
    font-weight: 700;
}

.hint-body {
    flex: 1;
    min-width: 0;
    margin-left: 18rpx;
}

.hint-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6rpx;
}

.hint-author {
    max-width: 340rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 24rpx;
    font-weight: 600;
    color: rgba(232, 176, 75, 0.9);
}

.hint-text {
    font-size: 28rpx;
    line-height: 1.6;
    color: #f4ead6;
}

.hint-time {
    flex-shrink: 0;
    margin-left: 12rpx;
    font-size: 20rpx;
    color: rgba(244, 234, 214, 0.4);
}
