<view class="page" wx:if="{{ready}}">
    <view class="user-card">
        <block wx:if="{{loggedIn}}">
            <view class="user-row">
                <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
                    <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
                    <view wx:else class="avatar-text">{{idShort}}</view>
                    <view class="avatar-badge">{{avatarBusy ? '…' : '换'}}</view>
                </button>
                <view class="user-meta">
                    <view class="name-line">
                        <text class="user-name">{{userName}}</text>
                        <view class="name-edit" bindtap="onEditNickname">编辑</view>
                    </view>
                    <text class="user-id">ID {{shortId}}</text>
                </view>
            </view>
            <text class="user-tip">点头像可换图，点「编辑」改昵称；头像和昵称会展示在你留的提示里</text>
        </block>
        <block wx:else>
            <view class="login-box">
                <text class="login-title">还没登录</text>
                <text class="login-desc">微信一键登录后，可以收藏宝物，并查看你带走和埋下的记录</text>
                <button class="btn-primary login-btn" bindtap="onLoginTap">微信一键登录</button>
            </view>
        </block>
    </view>

    <block wx:if="{{loggedIn}}">
        <view class="stats-card">
            <view class="stat-item">
                <text class="stat-num">{{stats.favorites}}</text>
                <text class="stat-label">收藏</text>
            </view>
            <view class="stat-divider"></view>
            <view class="stat-item">
                <text class="stat-num">{{stats.taken}}</text>
                <text class="stat-label">已带走</text>
            </view>
            <view class="stat-divider"></view>
            <view class="stat-item">
                <text class="stat-num">{{stats.buried}}</text>
                <text class="stat-label">我埋下的</text>
            </view>
        </view>

        <view class="tab-bar">
            <view class="tab-item {{tab === 'fav' ? 'tab-active' : ''}}" data-tab="fav" bindtap="switchTab">
                收藏 {{stats.favorites}}
            </view>
            <view class="tab-item {{tab === 'taken' ? 'tab-active' : ''}}" data-tab="taken" bindtap="switchTab">
                已带走 {{stats.taken}}
            </view>
            <view class="tab-item {{tab === 'buried' ? 'tab-active' : ''}}" data-tab="buried" bindtap="switchTab">
                我埋的 {{stats.buried}}
            </view>
        </view>

        <view class="list-card">
            <block wx:if="{{tab === 'fav'}}">
                <view wx:if="{{favorites.length === 0}}" class="empty-box">
                    <text class="empty-text">还没有收藏。在宝物详情页点「收藏」，就会出现在这里。</text>
                    <button class="btn-ghost empty-btn" size="mini" bindtap="goSeek">去寻宝</button>
                </view>
                <block wx:else>
                    <view
                        class="list-row"
                        wx:for="{{favorites}}"
                        wx:key="id"
                        data-id="{{item.id}}"
                        data-status="{{item.status}}"
                        bindtap="onFavTap">
                        <view class="row-main">
                            <view class="row-title-line">
                                <text class="row-name {{item.gone ? 'name-gone' : ''}}">{{item.name}}</text>
                                <text class="row-badge {{item.gone ? 'badge-gone' : ''}}">{{item.statusText}}</text>
                            </view>
                            <text class="row-sub" wx:if="{{item.subText}}">{{item.subText}}</text>
                        </view>
                        <view class="row-action" data-id="{{item.id}}" catchtap="onUnfavorite">取消收藏</view>
                    </view>
                </block>
            </block>
            <block wx:elif="{{tab === 'taken'}}">
                <view wx:if="{{taken.length === 0}}" class="empty-box">
                    <text class="empty-text">还没有带走宝物。走到 30 米内点「我已带走」，这里会记下你的战利品。</text>
                    <button class="btn-ghost empty-btn" size="mini" bindtap="goSeek">去寻宝</button>
                </view>
                <block wx:else>
                    <view class="list-row" wx:for="{{taken}}" wx:key="id">
                        <view class="row-main">
                            <text class="row-name">{{item.name}}</text>
                            <text class="row-sub">{{item.subText}}</text>
                        </view>
                    </view>
                </block>
            </block>
            <block wx:else>
                <view wx:if="{{buried.length === 0}}" class="empty-box">
                    <text class="empty-text">还没有埋过宝物。到地图上找个地方藏一个，等别人来找。</text>
                    <button class="btn-ghost empty-btn" size="mini" bindtap="goBury">去藏宝</button>
                </view>
                <block wx:else>
                    <view
                        class="list-row"
                        wx:for="{{buried}}"
                        wx:key="id"
                        data-id="{{item.id}}"
                        data-status="{{item.status}}"
                        bindtap="onBuriedTap">
                        <view class="row-main">
                            <view class="row-title-line">
                                <text class="row-name {{item.gone ? 'name-gone' : ''}}">{{item.name}}</text>
                                <text class="row-badge {{item.gone ? 'badge-gone' : ''}}">{{item.statusText}}</text>
                            </view>
                            <text class="row-sub">{{item.subText}}</text>
                        </view>
                    </view>
                </block>
            </block>
        </view>

        <view class="foot-tip">
            <text class="foot-text">收藏仅你自己可见；埋下的宝物被带走后仍保留在这里</text>
        </view>

        <view class="logout-wrap">
            <button class="btn-ghost logout-btn" bindtap="onLogoutTap">退出登录</button>
        </view>
    </block>
</view>
<view class="page state-page" wx:else>
    <view class="state-card">
        <text class="state-icon">◇</text>
        <text class="state-title">正在打开个人中心…</text>
        <text class="state-desc">正在读取你的资料与记录</text>
    </view>
</view>

<privacy-modal />
