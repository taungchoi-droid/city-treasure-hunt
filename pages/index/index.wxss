.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 72rpx 40rpx 64rpx;
    display: flex;
    flex-direction: column;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 56rpx;
}

.hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.me-entry {
    padding: 10rpx 26rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(232, 176, 75, 0.45);
    background: rgba(232, 176, 75, 0.08);
    font-size: 24rpx;
    font-weight: 600;
    color: #e8b04b;
}

.me-entry:active {
    opacity: 0.7;
}

.eyebrow {
    color: #e8b04b;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 6rpx;
}

.title {
    margin-top: 20rpx;
    font-size: 64rpx;
    font-weight: 800;
    line-height: 1.2;
    color: #f4ead6;
}

.subtitle {
    margin-top: 16rpx;
    color: rgba(244, 234, 214, 0.6);
    font-size: 28rpx;
    line-height: 1.6;
}

.entry-card {
    display: flex;
    flex-direction: column;
    gap: 28rpx;
}

.entry-main {
    box-sizing: border-box;
    padding: 44rpx 36rpx;
    border-radius: 28rpx;
    border: 2rpx solid rgba(232, 176, 75, 0.35);
    background: linear-gradient(160deg, rgba(232, 176, 75, 0.16), rgba(232, 176, 75, 0.05));
}

.entry-main-seek {
    border-color: rgba(70, 150, 245, 0.4);
    background: linear-gradient(160deg, rgba(70, 150, 245, 0.16), rgba(70, 150, 245, 0.05));
}

.entry-main:active {
    opacity: 0.7;
}

.entry-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #f4ead6;
}

.entry-desc {
    display: block;
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
    color: rgba(244, 234, 214, 0.6);
}

.stat-line {
    margin-top: auto;
    padding-top: 48rpx;
    text-align: center;
}

.stat-text {
    font-size: 24rpx;
    color: rgba(244, 234, 214, 0.45);
}
